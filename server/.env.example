# Chép file này thành .env (cùng thư mục server/) rồi điền thông tin máy của bạn.
# .env KHÔNG được commit lên git; biến môi trường đặt sẵn trong terminal sẽ được ưu tiên hơn.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pbl4_camera

# PBL4_PORT=5000

# --- Bảo mật ---
# Khóa API Client phải gửi kèm (header X-API-Key). Đặt GIỐNG HỆT PBL4_API_KEY trong client/.env.
# Sinh khóa ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(24))"
PBL4_API_KEY=
# Khóa ký cookie đăng nhập (để trống → khởi động lại Server là phải đăng nhập lại)
PBL4_SECRET_KEY=
# Tài khoản admin tạo lần đầu (khi bảng users còn trống). Để trống mật khẩu → Server sinh ngẫu nhiên và in ra màn hình.
PBL4_ADMIN_USER=admin
PBL4_ADMIN_PASSWORD=
# 0 = tắt lựa chọn "Người xem" (vào không cần mật khẩu) ở trang đăng nhập
# PBL4_ALLOW_GUEST=1
