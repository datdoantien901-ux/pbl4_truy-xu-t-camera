# Chép file này thành client/.env rồi điền link camera của bạn.
# .env KHÔNG được commit lên git (link camera thường chứa mật khẩu).
# Biến môi trường đặt sẵn trong terminal được ưu tiên hơn file này.

# --- Camera nhà (id "nha" trong client_config.json, đọc qua "url_env": "CAMERA_NHA_URL") ---
# Mẫu link RTSP theo hãng (192.168.1.x là IP camera trong mạng nhà, xem trong app hoặc trang quản trị router):
#   Imou / Dahua : rtsp://admin:<mã-an-toàn>@192.168.1.x:554/cam/realmonitor?channel=1&subtype=1
#   Ezviz        : rtsp://admin:<mã-xác-minh-6-chữ>@192.168.1.x:554/h264_stream   (bật RTSP/"Local Live" trong app)
#   Hikvision    : rtsp://admin:<mật-khẩu>@192.168.1.x:554/Streaming/Channels/102
#   TP-Link Tapo : rtsp://<tài-khoản-camera>:<mật-khẩu>@192.168.1.x:554/stream2   (tạo "Camera Account" trong app)
# subtype=1 / 102 / stream2 là luồng phụ độ phân giải thấp → nhẹ, ít trễ (đủ để chụp ảnh).
# Thử link trước bằng VLC: Media → Open Network Stream.
#
# Không phải RTSP thì đổi "type" của camera "nha" trong client_config.json:
#   webcam      : "type": "webcam",  CAMERA_NHA_URL=0
#   điện thoại  : "type": "http",    CAMERA_NHA_URL=http://192.168.1.x:8080/video   (app IP Webcam)
CAMERA_NHA_URL=
